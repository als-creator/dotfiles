# PyRadio — файл конфигурации пользователя
# Ниже приведены ВСЕ возможные настройки. Текущие параметры
# раскомментированы и активны, остальные закомментированы (у каждой
# указано значение по умолчанию). Просто раскомментируйте строку и
# измените значение, чтобы включить параметр.
#
# Полный список опций: pyradio -pc
#
# ============================================================
# ПЛЕЕР
# ============================================================

# player = mpv, mplayer, vlc
# Плеер для проигрывания или порядок их определения
# (первый найденный в системе будет использоваться).

# ============================================================
# ПЛЕЙЛИСТ
# ============================================================

# default_playlist = stations
# Плейлист по умолчанию, открываемый при старте.
# Можно указать путь к CSV-файлу или имя файла из каталога конфигурации.

default_station = 1
# Станция, которая включится автоматически при старте.
# Возможные значения:
#   -1  или  False — не включать ничего (по умолчанию)
#    0  или  "Random" — случайная станция
#    1..N — номер станции в плейлисте

# continuous_playback = False
# True — при смене плейлиста проигрывание не остановится, даже если
# текущая станция отсутствует в новом плейлисте.

# ============================================================
# МЫШЬ
# ============================================================

enable_mouse = False
# Включить поддержку мыши (прокрутка плейлиста, выбор станции и т.п.).
# Очень зависит от терминала, поэтому по умолчанию выключена.

wheel_adjusts_volume = True
# Обычно колесо прокручивает плейлист, а Shift-колесо меняет громкость.
# При True — наоборот: колесо меняет громкость, Shift-колесо — скролл.

# ============================================================
# ЗАПИСЬ И ОТКРЫТИЕ РЕСУРСОВ
# ============================================================

# recording_dir = default
# Каталог для записей ("default" — каталог по умолчанию).
# Меняйте только через окно: Config / General Options / Recordings dir.

# resource_opener = auto
# Программа для открытия каталогов/HTML-файлов.
# "auto" — сам найдёт xdg-open, gio, mimeopen, mimeo или handlr.

# ============================================================
# ЧАСЫ
# ============================================================

# enable_clock = False
# True — показывать текущее время в левом нижнем углу окна.
#
# time_format = 1
# Формат времени (если enable_clock = True):
#   0 - 24 ч с секундами
#   1 - 24 ч без секунд
#   2 - 12 ч с AM/PM и секундами
#   3 - 12 ч без AM/PM, с секундами
#   4 - 12 ч с AM/PM, без секунд
#   5 - 12 ч без AM/PM, без секунд

# ============================================================
# УВЕДОМЛЕНИЯ (ВСПЛЫВАЮЩИЕ ОКНА О ТРЕКАХ)
# ============================================================

enable_notifications = -1
# Показывать всплывающие уведомления о станции/треке.
# Возможные значения:
#   -1 — выключено
#    0 — включено (каждый новый трек)
#    x — включено с повтором каждые x секунд

# use_station_icon = True
# Скачивать и показывать логотип станции в уведомлениях
# (работает, если enable_notifications >= 0).

# remove_station_icons = True
# True — удалять кэш логотипов станций при выходе из программы.
# False — оставлять логотипы для повторного использования.

# ============================================================
# ОЗВУЧИВАНИЕ (TTS)
# ============================================================

# enable_tts = False
# Включить озвучивание текста (Text-to-Speech), если это
# поддерживается системой. Можно переключать клавишей "T".

# tts_volume = 50
# Громкость движка TTS (Linux и Windows).

# tts_rate = 0
# Скорость речи TTS.

# tts_pitch = 0
# Высота тона речи TTS (0 — системная по умолчанию).

# tts_verbosity = default
# Степень озвучивания пунктуации: "default" или "punctuation".

# tts_context = all
# Что озвучивать:
#   limited  - только системные сообщения и данные станций
#   window   - также текст окон
#   all      - озвучивать всё

# tts_speak_volume_change = 0
# Озвучивать изменение громкости. 0 - выключено,
# 300-3000 - задержка речи в миллисекундах.

# tts_speak_volume_change_start = False
# True — озвучивать и начало, и конец изменения громкости.

# ============================================================
# ЛОГИРОВАНИЕ НАЗВАНИЙ ТРЕКОВ
# ============================================================

# log_titles = False
# True — вести лог названий треков играющей станции (то же, что W
# во время работы программы).

# ============================================================
# ИНТЕГРАЦИЯ С СИСТЕМОЙ
# ============================================================

# use_os_media_controls = False
# True — управление через системные медиа-кнопки, гаджеты и
# внешние утилиты (например, playerctl).

# update_window_title = True
# True — обновлять заголовок терминала информацией о проигрывании.

# connection_timeout = 10
# Сколько секунд ждать подтверждения начала проигрывания станции.
# Допустимо: 5-60, 0 — отключить проверку.

# force_http = False
# True — все соединения принудительно по http (а не https).

buffering = 5
# Буферизация (секунды) перед началом воспроизведения.
# Допустимо: 5-60 (0 — отключить).

# auto_update_stations = True
# True — автоматически обновлять stations.csv при выходе новой версии.
# Иначе обновляйте вручную командой: pyradio -us

# mplayer_save_br = False
# Актуально для MPlayer: записывать реальный битрейт станции
# (нужно для расчёта буферизации).

# ============================================================
# ТЕМА ОФОРМЛЕНИЯ
# ============================================================

theme = mint-gray
# Тема оформления. Собственные темы кладутся в каталог
# ~/.config/pyradio/themes/ (файлы *.pyradio-theme).
# Встроенные: dark, light, dark_16_colors, light_16_colors,
# black_on_white (bow), white_on_black (wob) и Catppuccin, Dracula,
# Gruvbox и многие другие.
# Если следить за изменениями файла темы, поставьте "*" перед именем
# (например, '*my_theme') — актуально только для пользовательских тем.

use_transparency = True
# True — фон окна станций будет прозрачным (если запущен композитор).
# False — использовать цвета темы.

force_transparency = True
# True — все темы обязаны подчиняться настройке прозрачности выше
# (их собственный параметр "transparency" игнорируется).
# False — каждая тема использует своё значение.

# calculated_color_factor = 0
# Коэффициент осветления/затемнения фонового цвета для фона
# вторичных окон. Допустимо: 0-0.2. (0 — отключить)

console_theme = dark
# Тема для работы в виртуальной консоли Linux или терминале без
# поддержки смены цветов. Возможные значения: dark / light.

# ============================================================
# УПРАВЛЕНИЕ ПЛЕЙЛИСТОМ
# ============================================================

# confirm_station_deletion = True
# Спрашивать подтверждение при удалении станции.

# confirm_playlist_reload = True
# Спрашивать подтверждение при перезагрузке плейлиста, изменённого
# вне PintRadio.

auto_save_playlist = True
# True — автоматически сохранять изменённый плейлист при выходе.

# ============================================================
# УДАЛЁННОЕ УПРАВЛЕНИЕ (HTTP СЕРВЕР)
# ============================================================

# remote_control_server_ip = localhost
# IP-адрес для удалённого управления: localhost / 127.0.0.1 / lan.
#
# remote_control_server_port = 9998
# Порт сервера удалённого управления (1025-65535).
#
# remote_control_server_auto_start = False
# True — запускать HTTP-сервер удалённого управления автоматически.

# ============================================================
# ПРОЧЕЕ
# ============================================================

# localized_keys = None
# Файл локализованных (альтернативных) клавиш.

# xdg_compliant = True
# True — использовать стандарт XDG Base Directory (раскладывать
# рабочие данные по каталогам XDG). Не влияет на Windows.

# distro = Arch Linux (AUR)
# Имя дистрибутива-упаковщика. Если указано, PyRadio не разрешает
# обновлять (-U) и удалять (-R) пакет.
