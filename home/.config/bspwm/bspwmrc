#!/usr/bin/env sh
# bspwm bootstrap — mirrors the XFCE session (hotkeys live in sxhkdrc) 2026-09-12.

# Monitor: use every connected output, apply the default profile like XFCE.
if command -v xrandr >/dev/null 2>&1; then
    for m in $(xrandr --query | grep " connected" | cut -d" " -f1); do
        bspc monitor "$m" -d 1 2 3 4 5 6 7 8 9
    done
fi

# Look: dark theme like the XFCE panel.
bspc config border_width 1
bspc config normal_border_color '#1c1e24'
bspc config active_border_color '#f0833a'
bspc config focused_border_color '#f0833a'
bspc config presel_feedback_color '#f0833a'
bspc config gapless_monocle false
bspc config padding_gaps 6
bspc config split_ratio 0.5
bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config focus_follows_pointer false

# Key bindings (all the XFCE hotkeys).
sxhkd -c "$HOME/.config/sxhkd/sxhkdrc" &

# Optional bar (pick your favourite; xfce4-panel also works here).
command -v polybar >/dev/null 2>&1 && polybar &

# Autostart (XFCE mirror, guarded inside the script).
"$HOME/.local/bin/login-autostart.sh"