[Desktop Entry]
Version=1.0
Name=Kotatogram Desktop
Comment=Experimental Telegram Desktop fork
TryExec=@HOME@/.apps/Kotatogram
Exec=@HOME@/.apps/Kotatogram -workdir @HOME@/.local/share/KotatogramDesktop/ -autostart
Icon=kotatogram
Terminal=false
StartupWMClass=KotatogramDesktop
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;
Keywords=tg;chat;im;messaging;messenger;sms;tdesktop;kotatogram;
Actions=Quit;
X-GNOME-UsesNotifications=true

[Desktop Action Quit]
Exec=@HOME@/.apps/Kotatogram -workdir @HOME@/.local/share/KotatogramDesktop/ -quit
Name=Quit Kotatogram
Icon=application-exit
