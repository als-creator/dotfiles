# sway config — mirrors the XFCE session (hotkeys, launcher, autostart) 2026-09-12.
# Same personal hotkey set as the i3 / bspwm / openbox configs in this repo.
# Wayland: screenshots use grim+slurp (swap for flameshot/XDG portal if wanted).

set $mod Mod4

font pango:Noto Sans 10

# --- The XFCE hotkeys --------------------------------------------------------
bindsym $mod+Return exec foot
bindsym $mod+space   exec rofi -show drun
bindsym $mod+Shift+Return exec firefox
bindsym $mod+e       exec thunar
bindsym $mod+y       exec code --unity-launch %F

# --- AI agents (opencode / herdr) --------------------------------------------
bindsym $mod+a           exec foot -e opencode
bindsym $mod+Ctrl+Return exec foot -e herdr

# --- Screenshots (Wayland: grim+slurp) ---------------------------------------
bindsym Print          exec grim - | wl-copy
bindsym Shift+Print    exec grim -g "$(slurp)" - | wl-copy
bindsym Control+F12    exec grim -g "$(slurp)" - | wl-copy

# --- Media/brightness --------------------------------------------------------
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMuteVolume   exec pactl set-sink-mute   @DEFAULT_SINK@ toggle
bindsym XF86MonBrightnessUp   exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# --- Window management (omarchy-flavoured) -----------------------------------
bindsym $mod+q        kill
bindsym $mod+f        fullscreen toggle
bindsym $mod+v        split h
bindsym $mod+s        layout stacking
bindsym $mod+t        layout tabbed
bindsym $mod+z        focus parent
bindsym $mod+Left     focus left
bindsym $mod+Down     focus down
bindsym $mod+Up       focus up
bindsym $mod+Right    focus right
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right
bindsym $mod+Mouse1   floating
bindsym $mod+Mouse2  resize

# --- Workspaces (XFCE pager was numbered) ------------------------------------
bindsym $mod+1       workspace number 1
bindsym $mod+2       workspace number 2
bindsym $mod+3       workspace number 3
bindsym $mod+4       workspace number 4
bindsym $mod+5       workspace number 5
bindsym $mod+6       workspace number 6
bindsym $mod+7       workspace number 7
bindsym $mod+8       workspace number 8
bindsym $mod+9       workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# --- System -----------------------------------------------------------
bindsym $mod+Ctrl+l   exec loginctl lock-session
bindsym $mod+Shift+e  exec loginctl terminate-session
bindsym $mod+Ctrl+r   reload
bindsym $mod+Shift+r  reload
bindsym $mod+Ctrl+s   exec grim -g "$(slurp)" - | wl-copy

# --- Look: dark bottom bar like XFCE, gaps ----------------------------------
gaps inner 4
gaps outer 2
default_border pixel 1
bar {
    position bottom
    status_command i3status
    colors {
        background  #15161a
        statusline  #d6d6d6
        separator   #2b2e36
        focused_workspace    #f0833a #f0833a #15161a
        active_workspace     #2b2e36 #2b2e36 #d6d6d6
        inactive_workspace   #1c1e24 #1c1e24 #7a7f89
        urgent_workspace     #c0392b #c0392b #ffffff
    }
    tray_output primary
}

# --- Input (matches XFCE keyboard-layout.xml) --------------------------------
input "type:keyboard" {
    xkb_layout ru,us
    xkb_options grp:ctrl_shift_toggle,compose:ralt
    repeat_rate 40
    repeat_delay 250
}
input "type:touchpad" {
    tap enabled
    natural_scroll disabled
}

# --- Output (auto, like the XFCE setup; set your own wallpaper) ------------
# output "*" bg /path/to/wallpaper fill  
#     (sway does not expand ~, use an absolute path)

# --- Autostart (XFCE mirror) ------------------------------------------------
exec $HOME/.local/bin/login-autostart.sh