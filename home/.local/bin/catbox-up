#!/usr/bin/env bash
# Загрузка файла(ов) на catbox.moe, ссылки в буфер обмена + уведомление.
# Работает с картинками (png/jpg/webp/gif) и видео (mp4/webm, до ~200 МБ).
#
#   catbox-up <файл> [файл2 ...]
set -uo pipefail

if [ "$#" -lt 1 ]; then
  echo "Использование: catbox-up <файл> [файл2 ...]" >&2
  exit 1
fi

urls=()
for f in "$@"; do
  [ -f "$f" ] || { echo "Пропускаю (нет такого файла): $f" >&2; continue; }
  url="$(curl -s -F 'reqtype=fileupload' -F "fileToUpload=@${f}" https://catbox.moe/user/api.php)"
  if printf '%s' "$url" | grep -Eq '^https?://'; then
    urls+=("$url")
    echo "$url"
  else
    echo "Ошибка загрузки «$f»: $url" >&2
  fi
done

if [ "${#urls[@]}" -gt 0 ]; then
  printf '%s\n' "${urls[@]}" | xclip -selection clipboard >/dev/null 2>&1
  notify-send -u low "catbox: загружено" "$(printf '%s\n' "${urls[@]}")" >/dev/null 2>&1 || true
fi